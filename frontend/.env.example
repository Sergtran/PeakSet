# Base URL of the Liftraza API.
#
# Leave it as "/api" for local development: vite.config.ts proxies every
# /api/* request to the deployed API, which keeps the browser free of CORS.
#
# For a production build point it at the API itself, for example:
#   VITE_API_BASE_URL=https://peakset-api.azurewebsites.net/api
VITE_API_BASE_URL=/api
